{
  "name": "vireon-ai-editor",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "preview:renderer": "vite preview --port 5174",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build": "npm run build:renderer && tsc -p tsconfig.electron.json",
    "start": "electron ."
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "redux": "4.2.1",
    "@reduxjs/toolkit": "1.9.5"
  },
  "devDependencies": {
    "@types/node": "20.4.2",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "autoprefixer": "10.4.14",
    "concurrently": "8.2.0",
    "electron": "26.1.4",
    "postcss": "8.4.35",
    "tailwindcss": "3.5.3",
    "typescript": "5.3.3",
    "vite": "5.0.10"
  }
}
